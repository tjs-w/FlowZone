#!/bin/sh

set -eu

callflow_mcp_fail() {
  printf '%s\n' "$1" >&2
  exit "$2"
}

callflow_mcp_node_is_supported() {
  "$1" -e 'const [major, minor] = process.versions.node.split(".").map(Number); process.exit(major > 22 || (major === 22 && minor >= 13) ? 0 : 1)' </dev/null >/dev/null 2>&1
}

case "$0" in
  */*) CALLFLOW_MCP_LAUNCHER_PARENT=${0%/*} ;;
  *) callflow_mcp_fail "CallFlow MCP startup failed: invalid installed launcher path" 127 ;;
esac

CALLFLOW_MCP_LAUNCHER_DIR=$(CDPATH= cd -- "$CALLFLOW_MCP_LAUNCHER_PARENT" && pwd -P)
CALLFLOW_MCP_SERVER_PATH="$CALLFLOW_MCP_LAUNCHER_DIR/../server/dist/server.cjs"

if [ ! -f "$CALLFLOW_MCP_SERVER_PATH" ]; then
  callflow_mcp_fail "CallFlow MCP startup failed: missing bundled server" 127
fi

unset NODE_OPTIONS NODE_PATH

CALLFLOW_MCP_UNSUPPORTED_NODE_FOUND=0

for CALLFLOW_MCP_NODE_CANDIDATE in \
  "/Applications/ChatGPT.app/Contents/Resources/cua_node/bin/node" \
  "/opt/homebrew/bin/node" \
  "/usr/local/bin/node" \
  "/usr/bin/node"
do
  if [ -x "$CALLFLOW_MCP_NODE_CANDIDATE" ]; then
    if callflow_mcp_node_is_supported "$CALLFLOW_MCP_NODE_CANDIDATE"; then
      exec "$CALLFLOW_MCP_NODE_CANDIDATE" "$CALLFLOW_MCP_SERVER_PATH"
    fi
    CALLFLOW_MCP_UNSUPPORTED_NODE_FOUND=1
  fi
done

CALLFLOW_MCP_PATH_NODE=$(command -v node 2>/dev/null || true)
case "$CALLFLOW_MCP_PATH_NODE" in
  /*)
    if [ -x "$CALLFLOW_MCP_PATH_NODE" ]; then
      if callflow_mcp_node_is_supported "$CALLFLOW_MCP_PATH_NODE"; then
        exec "$CALLFLOW_MCP_PATH_NODE" "$CALLFLOW_MCP_SERVER_PATH"
      fi
      CALLFLOW_MCP_UNSUPPORTED_NODE_FOUND=1
    fi
    ;;
esac

if [ "$CALLFLOW_MCP_UNSUPPORTED_NODE_FOUND" -eq 1 ]; then
  callflow_mcp_fail "CallFlow MCP startup failed: Node.js 22.13.0 or newer is required" 126
fi

callflow_mcp_fail "CallFlow MCP startup failed: Node.js is unavailable" 127
