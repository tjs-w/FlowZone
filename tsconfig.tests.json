{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun", "node"],
    "rootDir": ".",
    "outDir": ".build/types/tests",
    "tsBuildInfoFile": ".build/types/tests.tsbuildinfo"
  },
  "include": [
    "packages/**/*.test.ts",
    "packages/**/test/**/*.ts",
    "scripts/callflow-license-approvals.ts",
    "scripts/check-coverage.ts",
    "scripts/*.test.ts",
    "tests/**/*.ts"
  ],
  "references": [
    { "path": "./packages/callflow-contracts" },
    { "path": "./packages/callflow-core" },
    { "path": "./packages/callflow-node" },
    { "path": "./packages/callflow-mcp" },
    { "path": "./packages/callflow-ui" },
    { "path": "./packages/flowzone-contracts" },
    { "path": "./packages/contracts" },
    { "path": "./packages/core" },
    { "path": "./packages/markdown-node" },
    { "path": "./packages/review-ui" },
    { "path": "./packages/host-mcp-apps" },
    { "path": "./packages/mcp-server" }
  ]
}
